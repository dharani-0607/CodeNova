# Copy to .env and fill in. Never commit .env.

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
# Shared key between backend and video service
SERVICE_API_KEY=replace-with-another-long-random-string

# ---- Database ----
# PostgreSQL (start it with: docker compose up -d db)
DATABASE_URL=postgresql+psycopg://campus:campus@localhost:5432/campus
# Or, for a quick start without Postgres:
# DATABASE_URL=sqlite:///./campus.db

# ---- Access ----
ALLOWED_EMAIL_DOMAIN=cb.amrita.edu
# These emails become admins when they register (comma-separated)
ADMIN_EMAILS=your.name@cb.amrita.edu
# Set to false only for local testing (skips the emailed code)
REQUIRE_EMAIL_VERIFICATION=true

# ---- URLs ----
FRONTEND_ORIGIN=http://localhost:5173
# Browsers reach the video service through the frontend proxy
VIDEO_SERVICE_PUBLIC_URL=/video
BACKEND_URL=http://localhost:8000

# ---- Email (Gmail: use an App Password, not your normal password) ----
# Leave SMTP_HOST empty to print emails (and verification codes) in the backend console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=you@gmail.com
SMTP_USE_TLS=true

# ---- Browser push (run: python scripts/generate_vapid_keys.py) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your.name@cb.amrita.edu

# ---- AI moderation ----
MODERATION_MODEL=unitary/toxic-bert
MODERATION_USE_ML=true

# ---- Video service ----
# Frames per second analysed per camera (CPU laptop: 2-5)
PROCESS_FPS=4
# Model weights (see video_service/weights/README.md)
DETECT_MODEL=yolov8n.pt
POSE_MODEL=yolov8n-pose.pt
FIRE_MODEL=weights/fire_smoke.pt
SMOKING_MODEL=weights/smoking.pt
